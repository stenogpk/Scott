{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomCode": {
        "public": {
          ".read": "auth != null",
          "hostId": {
            ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || data.val() === auth.uid || (newData.val() === auth.uid && now - root.child('rooms').child($roomCode).child('public').child('players').child(data.val()).child('lastSeenAt').val() > 20000))"
          },
          "code": {
            ".write": "auth != null && root.child('rooms').child($roomCode).child('public').child('hostId').val() === auth.uid"
          },
          "targetScore": {
            ".write": "auth != null && root.child('rooms').child($roomCode).child('public').child('hostId').val() === auth.uid"
          },
          "started": {
            ".write": "auth != null && root.child('rooms').child($roomCode).child('public').child('hostId').val() === auth.uid"
          },
          "gameState": {
            ".write": "auth != null && root.child('rooms').child($roomCode).child('public').child('hostId').val() === auth.uid"
          },
          "updatedAt": {
            ".write": "auth != null && root.child('rooms').child($roomCode).child('public').child('hostId').val() === auth.uid"
          },
          "players": {
            "$playerId": {
              ".write": "auth != null && (auth.uid === $playerId || auth.uid === root.child('rooms').child($roomCode).child('public').child('hostId').val())"
            }
          }
        },
        "privateHands": {
          "$playerId": {
            ".read": "auth != null && (auth.uid === $playerId || auth.uid === root.child('rooms').child($roomCode).child('public').child('hostId').val())",
            ".write": "auth != null && auth.uid === root.child('rooms').child($roomCode).child('public').child('hostId').val()"
          }
        },
        "actions": {
          ".read": "auth != null && auth.uid === root.child('rooms').child($roomCode).child('public').child('hostId').val()",
          "$playerId": {
            ".write": "auth != null && (auth.uid === $playerId || auth.uid === root.child('rooms').child($roomCode).child('public').child('hostId').val())"
          }
        }
      }
    }
  }
}
